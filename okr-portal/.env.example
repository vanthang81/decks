# ===== OKR Portal — biến môi trường (KHÔNG commit .env thật) =====

# Postgres btmh_data (dùng CHUNG DB với price-engine/decks để đọc pe_* / pe_cf_budget).
# App runtime dùng user btmh_app (đã GRANT). DDL chạy bằng superuser (xem db/README).
DATABASE_URL=postgres://btmh_app:PASSWORD@host.docker.internal:5435/btmh_data

# Auth.js v5 — Google OAuth (tạo credential ở Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=https://okr.consultx.vn   # BẮT BUỘC để Auth.js redirect đúng domain

# Tùy chọn: base URL tuyệt đối (fallback header nginx nếu trống).
APP_URL=https://okr.consultx.vn

# Khóa cho cron/n8n gọi POST /api/kpi/sync + /api/reminders/checkin. openssl rand -hex 16
SYNC_KEY=

# Webhook n8n "Deck Mail" để gửi email nhắc check-in (tái dùng của decks-portal).
N8N_MAIL_WEBHOOK=https://automation.consultx.vn/webhook/deck-mail

