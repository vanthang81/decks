# decks-portal — biến môi trường (đặt trong .env trên VPS, NGOÀI git)
# App
APP_URL=https://deck.consultx.vn
AUTH_URL=https://deck.consultx.vn   # BẮT BUỘC: Auth.js dựng URL callback/redirect từ đây (sau proxy)
AUTH_SECRET=            # openssl rand -base64 32  (dùng cho Auth.js + phiên viewer)
AUTH_TRUST_HOST=true

# Google OAuth (tái dùng client của price-engine — thêm redirect URI:
#   https://deck.consultx.vn/api/auth/callback/google  và bản staging tương ứng)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres (user app btmh_app, DB btmh_data)
DATABASE_URL=postgres://btmh_app:PASSWORD@HOST:5432/btmh_data

# Gửi email link/OTP qua n8n (app KHÔNG giữ SMTP cred)
N8N_MAIL_WEBHOOK=https://automation.consultx.vn/webhook/deck-mail

# Publish API (POST /api/publish, header x-publish-key) — cho Claude/máy tự đẩy deck lên
PUBLISH_KEY=            # openssl rand -hex 24
